pipeline {
    agent {
        kubernetes {
            label 'todo-app'
            defaultContainer 'maven'
            yamlFile 'supply-chain-security-ref/supply-chain-security-pipeline/pod-template.yaml'
        }
    }

    environment {
        PIPELINE_VERSION = 'cosign-sign-attest-v1-2026-07-21'
        REGISTRY = 'docker.io'  // Change to your registry: gcr.io, ecr, etc.
        IMAGE_NAME = 'agovindasamy/arun'
        IMAGE_TAG = "${BUILD_NUMBER}"
        LATEST_TAG = 'latest'
        GIT_REPO = 'https://github.com/Github-Arun-Repo/platform-engineering-reference-architectures.git'
        GITHUB_CREDENTIALS_ID = 'github-arun-repository'
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials'
        SECURITY_REPORT_DIR = 'supply-chain-security-ref/security-reports'
        GITLEAKS_VERSION = '8.24.2'
        COSIGN_VERSION = '2.4.1'
        COSIGN_KEY_CREDENTIALS_ID = 'cosign-private-key'
        COSIGN_PASSWORD_CREDENTIALS_ID = 'cosign-password'
        SONARQUBE_SERVER = ''  // Leave empty to use Jenkins default SonarQube installation
        SONARQUBE_TOKEN_CREDENTIALS_ID = 'sonarqube_secret'
        SONAR_PROJECT_KEY = 'platform-engineering-reference-architectures'
        SONAR_PROJECT_NAME = 'platform-engineering-reference-architectures'
        DEPENDENCY_TRACK_URL = 'http://dtrack-dependency-track-api-server.dependency-track.svc.cluster.local:8080'
        DEPENDENCY_TRACK_API_KEY_CREDENTIALS_ID = 'owasp_dependency_track'
        DEPENDENCY_TRACK_PROJECT_NAME = 'platform-engineering-reference-architectures'
        NVD_API_KEY_CREDENTIALS_ID = 'nvd-api-key'
        DEPENDENCY_CHECK_DATA_DIR = '/var/jenkins-cache/owasp-dependency-check'
        ENABLE_SONARQUBE = 'true'
        ENABLE_SONARQUBE_QUALITY_GATE = 'true'
        JACOCO_MIN_LINE_COVERAGE = '70'
        DEPENDENCY_GATE_FAIL_ON_CRITICAL = 'true'
        DEPENDENCY_GATE_FAIL_ON_HIGH = 'true'
        TRIVY_FAIL_ON_HIGH = 'false'
        TRIVY_BLOCK_ON_SCAN_ERROR = 'true'
    }

    parameters {
        booleanParam(name: 'ENABLE_COSIGN', defaultValue: true, description: 'Sign the pushed image digest and create Cosign attestations using Jenkins-managed credentials.')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        // Keep a generous global timeout and rely on stage-level timeouts for scan tools.
        timeout(time: 180, unit: 'MINUTES')
        // Avoid aborting an in-flight build when report commits trigger a new build.
        disableConcurrentBuilds(abortPrevious: false)
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Pipeline version: ${PIPELINE_VERSION}"
                    echo "Checking out source code from ${GIT_REPO}"
                }
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: "${GIT_REPO}", credentialsId: "${GITHUB_CREDENTIALS_ID}"]]
                ])
            }
        }

        stage('Repository Secret Scan') {
            steps {
                container('maven') {
                    script {
                        echo "Scanning repository for secret leaks with Gitleaks..."
                        sh '''
                            mkdir -p ${SECURITY_REPORT_DIR} .tools
                            rm -f ${SECURITY_REPORT_DIR}/gitleaks-report.json \
                                  ${SECURITY_REPORT_DIR}/gitleaks-report.html \
                                  ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt

                            GITLEAKS_ARCHIVE="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
                            GITLEAKS_URL="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${GITLEAKS_ARCHIVE}"

                            if [ ! -x .tools/gitleaks ]; then
                                echo "Downloading Gitleaks ${GITLEAKS_VERSION} from ${GITLEAKS_URL}"
                                rm -f ".tools/${GITLEAKS_ARCHIVE}"
                                curl --fail --location --retry 3 --retry-all-errors \
                                    --connect-timeout 15 --max-time 180 --progress-bar \
                                    "${GITLEAKS_URL}" \
                                    --output ".tools/${GITLEAKS_ARCHIVE}"
                                test -s ".tools/${GITLEAKS_ARCHIVE}"
                                ls -lh ".tools/${GITLEAKS_ARCHIVE}"
                                tar -xzf ".tools/${GITLEAKS_ARCHIVE}" -C .tools gitleaks
                                chmod +x .tools/gitleaks
                                ./.tools/gitleaks version
                            fi

                            set +e
                            ./.tools/gitleaks dir . \
                                --config supply-chain-security-ref/supply-chain-security-pipeline/gitleaks.toml \
                                --gitleaks-ignore-path supply-chain-security-ref/supply-chain-security-pipeline/.gitleaksignore \
                                --report-format json \
                                --report-path ${SECURITY_REPORT_DIR}/gitleaks-report.json \
                                --redact \
                                --exit-code 1
                            GITLEAKS_STATUS=$?
                            set -e

                            if [ ! -s ${SECURITY_REPORT_DIR}/gitleaks-report.json ]; then
                                echo '[]' > ${SECURITY_REPORT_DIR}/gitleaks-report.json
                            fi

                            FINDINGS_COUNT=$(grep -o '"RuleID"' ${SECURITY_REPORT_DIR}/gitleaks-report.json | wc -l | tr -d ' ')
                            if [ -z "${FINDINGS_COUNT}" ]; then
                                FINDINGS_COUNT=0
                            fi

                            GITLEAKS_STATUS_CLASS=""
                            if [ "${GITLEAKS_STATUS}" -eq 0 ]; then
                                GITLEAKS_STATUS_TEXT="No secrets detected"
                                GITLEAKS_STATUS_CLASS="clean"
                            elif [ "${GITLEAKS_STATUS}" -eq 1 ]; then
                                GITLEAKS_STATUS_TEXT="Secrets detected"
                            else
                                GITLEAKS_STATUS_TEXT="Gitleaks scan error"
                                GITLEAKS_STATUS_CLASS="error"
                            fi

                            cat > ${SECURITY_REPORT_DIR}/gitleaks-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gitleaks Secret Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #f6f8fa; color: #24292f; margin: 0; padding: 32px; }
        .panel { max-width: 900px; margin: 0 auto; background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: 24px; }
        .meta { margin-bottom: 16px; color: #57606a; }
        .status { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; margin-bottom: 12px; background: #fff8c5; color: #9a6700; }
        .status.clean { background: #dafbe1; color: #116329; }
        .status.error { background: #ffebe9; color: #cf222e; }
        .actions a { display: inline-block; padding: 8px 14px; border-radius: 6px; background: #1f6feb; color: #fff; text-decoration: none; font-size: 0.9rem; }
        .actions a:hover { background: #1a5fb7; }
        ul { color: #57606a; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Gitleaks Secret Report</h1>
        <p class="meta">Repository: platform-engineering-reference-architectures</p>
        <p class="status ${GITLEAKS_STATUS_CLASS}">${GITLEAKS_STATUS_TEXT}</p>
        <p class="meta">Findings: ${FINDINGS_COUNT} &middot; Build: ${BUILD_NUMBER}</p>
        <div class="actions">
            <a href="gitleaks-report.json">Open Raw JSON Report</a>
        </div>
        <h2>Summary</h2>
        <ul>
            <li>The JSON report is generated by Gitleaks with redacted findings.</li>
            <li>The pipeline fails when Gitleaks exits with findings or scan errors.</li>
            <li>Use the raw JSON report for exact rule IDs, file paths, and line numbers.</li>
        </ul>
    </div>
</body>
</html>
EOF

                            echo "${GITLEAKS_STATUS}" > ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt
                            echo "Gitleaks scan complete. Status=${GITLEAKS_STATUS}, findings=${FINDINGS_COUNT}"
                            wc -c ${SECURITY_REPORT_DIR}/gitleaks-report.json ${SECURITY_REPORT_DIR}/gitleaks-report.html ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt
                        '''
                    }
                }
            }
        }

        stage('Secret Exposure Gate') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Explicitly enforce secret detection policy before any further pipeline progress.
                        sh '''
                            GITLEAKS_STATUS="$(cat ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt 2>/dev/null || echo 2)"
                            if [ "${GITLEAKS_STATUS}" -eq 1 ]; then
                                echo "Gitleaks detected potential secrets. Failing secret validation gate."
                                exit 1
                            fi
                            if [ "${GITLEAKS_STATUS}" -gt 1 ]; then
                                echo "Gitleaks scan errored. Failing secret validation gate."
                                exit 1
                            fi
                            echo "Secret validation gate passed."
                        '''
                    }
                }
            }
        }

        stage('Unit Test Execution (JUnit)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Execute unit tests and persist test execution status for explicit gate evaluation.
                        echo "Running unit tests (JUnit)..."
                        dir('supply-chain-security-ref/sample-application') {
                            sh '''
                                mkdir -p ../../${SECURITY_REPORT_DIR}
                                set +e
                                mvn -B clean test
                                TEST_STATUS=$?
                                set -e
                                echo "${TEST_STATUS}" > ../../${SECURITY_REPORT_DIR}/test-exit-code.txt
                            '''
                        }
                    }
                }
            }
        }

        stage('Unit Test Result Gate') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Fail fast if any unit test failed.
                        sh '''
                            TEST_STATUS="$(cat ${SECURITY_REPORT_DIR}/test-exit-code.txt 2>/dev/null || echo 2)"
                            if [ "${TEST_STATUS}" -ne 0 ]; then
                                echo "Unit tests failed. Blocking pipeline in test validation gate."
                                exit 1
                            fi
                            echo "Test validation gate passed."
                        '''
                    }
                }
            }
        }

        stage('Coverage Evidence Generation (JaCoCo)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Generate JaCoCo coverage report after successful unit tests.
                        dir('supply-chain-security-ref/sample-application') {
                            sh '''
                                mkdir -p ../../${SECURITY_REPORT_DIR}
                                mvn -B jacoco:report
                            '''
                        }
                    }
                }
            }
        }

        stage('Coverage Threshold Gate') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Enforce minimum line coverage threshold before security-heavy steps.
                        dir('supply-chain-security-ref/sample-application') {
                            sh '''
                                JACOCO_XML="target/site/jacoco/jacoco.xml"
                                if [ ! -s "${JACOCO_XML}" ]; then
                                    echo "Coverage report missing: ${JACOCO_XML}. Failing coverage validation gate."
                                    exit 1
                                fi

                                # JaCoCo writes jacoco.xml as a single line, so split on each <counter tag
                                # and read the report-level LINE counter (the last LINE counter in the file).
                                COVERAGE_PCT=$(awk 'BEGIN{RS="<counter "} /type="LINE"/ {
                                        if (match($0, /missed="[0-9]+"/)) { s=substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", s); missed=s }
                                        if (match($0, /covered="[0-9]+"/)) { s=substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", s); covered=s }
                                    } END {
                                        total=missed+covered
                                        if (total > 0) printf "%.2f", (covered*100)/total; else print "0.00"
                                    }' "${JACOCO_XML}")
                                echo "${COVERAGE_PCT}" > ../../${SECURITY_REPORT_DIR}/jacoco-line-coverage.txt
                                echo "JaCoCo line coverage: ${COVERAGE_PCT}% (minimum required: ${JACOCO_MIN_LINE_COVERAGE}%)"

                                awk -v actual="${COVERAGE_PCT}" -v min="${JACOCO_MIN_LINE_COVERAGE}" 'BEGIN { if (actual+0 < min+0) exit 1; else exit 0 }' || {
                                    echo "Coverage validation gate failed: ${COVERAGE_PCT}% is below ${JACOCO_MIN_LINE_COVERAGE}%"
                                    exit 1
                                }

                                echo "Coverage validation gate passed."
                            '''
                        }
                    }
                }
            }
        }

        stage('SCA Dependency Scan (OWASP Dependency-Check)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Perform SCA dependency vulnerability scanning before SAST and image build.
                        // OWASP Dependency-Check 9+ downloads NVD CVE data from the NVD REST API.
                        // An NVD API key is required to avoid rate-limited/rejected update requests.
                        withCredentials([string(credentialsId: "${NVD_API_KEY_CREDENTIALS_ID}", variable: 'NVD_API_KEY')]) {
                            dir('supply-chain-security-ref/sample-application') {
                                sh '''
                                    mkdir -p ../../${SECURITY_REPORT_DIR}
                                    mkdir -p "${DEPENDENCY_CHECK_DATA_DIR}"

                                    if [ -z "${NVD_API_KEY}" ]; then
                                        echo "ERROR: NVD API key is empty. Configure the '${NVD_API_KEY_CREDENTIALS_ID}' credential."
                                        echo "Request a free key at https://nvd.nist.gov/developers/request-an-api-key"
                                        exit 1
                                    fi

                                    # Persist the CVE data in the mounted cache so updates are incremental
                                    # across builds and the pipeline is resilient to NVD rate limits.
                                    run_check() {
                                        mvn -B org.owasp:dependency-check-maven:check \
                                            -Dformat=ALL \
                                            -DfailBuildOnCVSS=11 \
                                            -DnvdApiKey=${NVD_API_KEY} \
                                            -DnvdApiDelay=6000 \
                                            -DdataDirectory=${DEPENDENCY_CHECK_DATA_DIR} \
                                            -Dout=../../${SECURITY_REPORT_DIR}
                                    }

                                    # Self-heal an incompatible/corrupt cached CVE database (e.g. left by a
                                    # different Dependency-Check version): purge and rebuild once, then retry.
                                    if ! run_check; then
                                        echo "Dependency-Check failed; purging cached CVE database and retrying once..."
                                        mvn -B org.owasp:dependency-check-maven:purge \
                                            -DdataDirectory=${DEPENDENCY_CHECK_DATA_DIR} || \
                                            rm -rf "${DEPENDENCY_CHECK_DATA_DIR}"/*
                                        mkdir -p "${DEPENDENCY_CHECK_DATA_DIR}"
                                        run_check
                                    fi
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('SCA Policy Gate (Critical/High)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Enforce dependency CVE policy (Critical/High) before SAST and image build.
                        sh '''
                            DEP_REPORT="${SECURITY_REPORT_DIR}/dependency-check-report.json"
                            if [ ! -s "${DEP_REPORT}" ]; then
                                echo "Dependency-Check JSON report missing. Failing dependency security gate."
                                exit 1
                            fi

                            DEP_CRITICAL_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"critical"' "${DEP_REPORT}" | wc -l | tr -d ' ')
                            DEP_HIGH_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"high"' "${DEP_REPORT}" | wc -l | tr -d ' ')

                            [ -n "${DEP_CRITICAL_COUNT}" ] || DEP_CRITICAL_COUNT=0
                            [ -n "${DEP_HIGH_COUNT}" ] || DEP_HIGH_COUNT=0

                            echo "${DEP_CRITICAL_COUNT}" > ${SECURITY_REPORT_DIR}/dependency-check-critical-count.txt
                            echo "${DEP_HIGH_COUNT}" > ${SECURITY_REPORT_DIR}/dependency-check-high-count.txt

                            if [ "${DEPENDENCY_GATE_FAIL_ON_CRITICAL}" = "true" ] && [ "${DEP_CRITICAL_COUNT}" -gt 0 ]; then
                                echo "Dependency security gate failed: ${DEP_CRITICAL_COUNT} Critical CVEs found."
                                exit 1
                            fi

                            if [ "${DEPENDENCY_GATE_FAIL_ON_HIGH}" = "true" ] && [ "${DEP_HIGH_COUNT}" -gt 0 ]; then
                                echo "Dependency security gate failed: ${DEP_HIGH_COUNT} High CVEs found."
                                exit 1
                            fi

                            echo "Dependency security gate passed. Critical=${DEP_CRITICAL_COUNT}, High=${DEP_HIGH_COUNT}"
                        '''
                    }
                }
            }
        }

        stage('SAST Code Analysis (SonarQube)') {
            steps {
                container('maven') {
                    script {
                        echo "Running SonarQube analysis..."
                        dir('supply-chain-security-ref/sample-application') {
                            withCredentials([string(credentialsId: "${SONARQUBE_TOKEN_CREDENTIALS_ID}", variable: 'SONAR_TOKEN')]) {
                                                                def runSonarScan = {
                                                                        sh '''
                                                                                set -e
                                                                                PROJECT_KEY="${SONAR_PROJECT_KEY}"
                                                                                PROJECT_NAME="${SONAR_PROJECT_NAME}"

                                                                                echo "Validating SonarQube token against ${SONAR_HOST_URL}..."
                                                                                AUTH_RESPONSE=$(curl -sS -H "Authorization: Bearer ${SONAR_TOKEN}" "${SONAR_HOST_URL}/api/authentication/validate")
                                                                                echo "${AUTH_RESPONSE}" | grep -q '"valid":true' || {
                                                                                    echo "ERROR: Sonar token is invalid for this SonarQube server."
                                                                                    exit 1
                                                                                }

                                                                                echo "Skipping project search/create precheck to avoid permission-gated API failures."
                                                                                echo "Proceeding with analysis for project key: ${PROJECT_KEY}"

                                                                                mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                                                                    -DskipTests \
                                                                                    -Dsonar.projectKey="${PROJECT_KEY}" \
                                                                                    -Dsonar.projectName="${PROJECT_NAME}" \
                                                                                    -Dsonar.token="${SONAR_TOKEN}"

                                                                                mkdir -p ../../${SECURITY_REPORT_DIR}
                                                                                SONAR_REPORT_JSON="../../${SECURITY_REPORT_DIR}/sonarqube-report.json"
                                                                                SONAR_REPORT_HTML="../../${SECURITY_REPORT_DIR}/sonarqube-report.html"

                                                                                SONAR_MEASURES_JSON=$(curl -sS -H "Authorization: Bearer ${SONAR_TOKEN}" --get \
                                                                                        "${SONAR_HOST_URL}/api/measures/component" \
                                                                                        --data-urlencode "component=${PROJECT_KEY}" \
                                                                                        --data-urlencode "metricKeys=bugs,vulnerabilities,code_smells,coverage,duplicated_lines_density,ncloc")

                                                                                SONAR_QG_JSON=$(curl -sS -H "Authorization: Bearer ${SONAR_TOKEN}" --get \
                                                                                        "${SONAR_HOST_URL}/api/qualitygates/project_status" \
                                                                                        --data-urlencode "projectKey=${PROJECT_KEY}" || true)

                                                                                get_metric() {
                                                                                        key="$1"
                                                                                        echo "${SONAR_MEASURES_JSON}" | tr -d '\n' | sed -n "s/.*\\\"metric\\\":\\\"${key}\\\",\\\"value\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p" | head -n 1
                                                                                }

                                                                                SONAR_BUGS=$(get_metric bugs)
                                                                                SONAR_VULNS=$(get_metric vulnerabilities)
                                                                                SONAR_SMELLS=$(get_metric code_smells)
                                                                                SONAR_COVERAGE=$(get_metric coverage)
                                                                                SONAR_DUPLICATION=$(get_metric duplicated_lines_density)
                                                                                SONAR_NCLOC=$(get_metric ncloc)
                                                                                SONAR_QG_STATUS=$(echo "${SONAR_QG_JSON}" | tr -d "\\n" | sed -n "s/.*\\\"status\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p" | head -n 1)

                                                                                [ -n "${SONAR_BUGS}" ] || SONAR_BUGS="unknown"
                                                                                [ -n "${SONAR_VULNS}" ] || SONAR_VULNS="unknown"
                                                                                [ -n "${SONAR_SMELLS}" ] || SONAR_SMELLS="unknown"
                                                                                [ -n "${SONAR_COVERAGE}" ] || SONAR_COVERAGE="unknown"
                                                                                [ -n "${SONAR_DUPLICATION}" ] || SONAR_DUPLICATION="unknown"
                                                                                [ -n "${SONAR_NCLOC}" ] || SONAR_NCLOC="unknown"
                                                                                [ -n "${SONAR_QG_STATUS}" ] || SONAR_QG_STATUS="unknown"

                                                                                cat > "${SONAR_REPORT_JSON}" <<EOF
                                                                {
                                                                    "projectKey": "${PROJECT_KEY}",
                                                                    "projectName": "${PROJECT_NAME}",
                                                                    "server": "${SONAR_HOST_URL}",
                                                                    "dashboardUrl": "${SONAR_HOST_URL}/dashboard?id=${PROJECT_KEY}",
                                                                    "qualityGate": "${SONAR_QG_STATUS}",
                                                                    "measures": {
                                                                        "bugs": "${SONAR_BUGS}",
                                                                        "vulnerabilities": "${SONAR_VULNS}",
                                                                        "codeSmells": "${SONAR_SMELLS}",
                                                                        "coverage": "${SONAR_COVERAGE}",
                                                                        "duplication": "${SONAR_DUPLICATION}",
                                                                        "ncloc": "${SONAR_NCLOC}"
                                                                    }
                                                                }
EOF

                                                                                cat > "${SONAR_REPORT_HTML}" <<EOF
                                                                <html>
                                                                <head><title>SonarQube Summary</title></head>
                                                                <body>
                                                                    <h1>SonarQube Summary</h1>
                                                                    <p><strong>Project:</strong> ${PROJECT_NAME} (${PROJECT_KEY})</p>
                                                                    <p><strong>Quality Gate:</strong> ${SONAR_QG_STATUS}</p>
                                                                    <p><strong>Dashboard:</strong> <a href="${SONAR_HOST_URL}/dashboard?id=${PROJECT_KEY}">${SONAR_HOST_URL}/dashboard?id=${PROJECT_KEY}</a></p>
                                                                    <table border="1" cellspacing="0" cellpadding="6">
                                                                        <tr><th>Metric</th><th>Value</th></tr>
                                                                        <tr><td>Bugs</td><td>${SONAR_BUGS}</td></tr>
                                                                        <tr><td>Vulnerabilities</td><td>${SONAR_VULNS}</td></tr>
                                                                        <tr><td>Code Smells</td><td>${SONAR_SMELLS}</td></tr>
                                                                        <tr><td>Coverage (%)</td><td>${SONAR_COVERAGE}</td></tr>
                                                                        <tr><td>Duplicated Lines Density (%)</td><td>${SONAR_DUPLICATION}</td></tr>
                                                                        <tr><td>Lines of Code</td><td>${SONAR_NCLOC}</td></tr>
                                                                    </table>
                                                                </body>
                                                                </html>
EOF
                                                                        '''
                                                                }

                                if (env.SONARQUBE_SERVER?.trim()) {
                                    withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                                                                runSonarScan()
                                    }
                                } else {
                                    withSonarQubeEnv() {
                                                                                runSonarScan()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('SAST Quality Gate (SonarQube)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Block pipeline if the SonarQube quality gate fails.
                        // Polls the SonarQube API directly using the analysis task metadata
                        // (report-task.txt) instead of relying on a Jenkins webhook, so the
                        // stage never hangs waiting for a callback that may not be configured.
                        dir('supply-chain-security-ref/sample-application') {
                            withCredentials([string(credentialsId: "${SONARQUBE_TOKEN_CREDENTIALS_ID}", variable: 'SONAR_TOKEN')]) {
                                timeout(time: 10, unit: 'MINUTES') {
                                    sh '''
                                        set -e
                                        REPORT_TASK="target/sonar/report-task.txt"
                                        if [ ! -f "${REPORT_TASK}" ]; then
                                            echo "ERROR: ${REPORT_TASK} not found; the SonarQube analysis stage must run first."
                                            exit 1
                                        fi

                                        SERVER_URL=$(sed -n "s/^serverUrl=//p" "${REPORT_TASK}")
                                        CE_TASK_URL=$(sed -n "s/^ceTaskUrl=//p" "${REPORT_TASK}")
                                        CE_TASK_ID=$(sed -n "s/^ceTaskId=//p" "${REPORT_TASK}")
                                        echo "Waiting for SonarQube to process analysis task ${CE_TASK_ID}..."

                                        ANALYSIS_ID=""
                                        i=0
                                        while [ ${i} -lt 60 ]; do
                                            CE_JSON=$(curl -sS -H "Authorization: Bearer ${SONAR_TOKEN}" "${CE_TASK_URL}")
                                            CE_STATUS=$(echo "${CE_JSON}" | tr -d "\\n" | sed -n "s/.*\\\"status\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p" | head -n 1)
                                            echo "Compute engine task status: ${CE_STATUS}"
                                            if [ "${CE_STATUS}" = "SUCCESS" ]; then
                                                ANALYSIS_ID=$(echo "${CE_JSON}" | tr -d "\\n" | sed -n "s/.*\\\"analysisId\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p" | head -n 1)
                                                break
                                            fi
                                            if [ "${CE_STATUS}" = "FAILED" ] || [ "${CE_STATUS}" = "CANCELED" ]; then
                                                echo "ERROR: SonarQube compute engine task ${CE_STATUS}."
                                                exit 1
                                            fi
                                            i=$((i + 1))
                                            sleep 5
                                        done

                                        if [ -z "${ANALYSIS_ID}" ]; then
                                            echo "ERROR: Timed out waiting for SonarQube to finish processing the analysis."
                                            exit 1
                                        fi

                                        QG_JSON=$(curl -sS -H "Authorization: Bearer ${SONAR_TOKEN}" \
                                            "${SERVER_URL}/api/qualitygates/project_status?analysisId=${ANALYSIS_ID}")
                                        QG_STATUS=$(echo "${QG_JSON}" | tr -d "\\n" | sed -n "s/.*\\\"status\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p" | head -n 1)
                                        echo "Quality gate status: ${QG_STATUS}"
                                        if [ "${QG_STATUS}" != "OK" ]; then
                                            echo "ERROR: SonarQube quality gate failed (status=${QG_STATUS})."
                                            exit 1
                                        fi
                                        echo "SonarQube quality gate passed."
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Build Application') {
            steps {
                container('maven') {
                    script {
                        echo "Packaging Spring Boot application..."
                        dir('supply-chain-security-ref/sample-application') {
                            sh 'mvn -B package -DskipTests'
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker') {
                    script {
                        // Purpose: Build immutable runtime artifacts before SBOM and vulnerability evaluation.
                        echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                        dir('supply-chain-security-ref/sample-application') {
                            sh '''
                                docker build \
                                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                                    -t ${IMAGE_NAME}:${LATEST_TAG} \
                                    -f Dockerfile .
                            '''
                        }
                    }
                }
            }
        }

        stage('Generate CycloneDX SBOM with Trivy') {
            steps {
                container('docker') {
                    script {
                        // Purpose: Create a CycloneDX SBOM for the built image and persist reports for reuse.
                        echo "Generating CycloneDX SBOM with Trivy for Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                        sh '''
                            mkdir -p ${SECURITY_REPORT_DIR}
                            rm -f ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json \
                                  ${SECURITY_REPORT_DIR}/sbom.trivy.log \
                                  ${SECURITY_REPORT_DIR}/sbom-report.html \
                                  ${SECURITY_REPORT_DIR}/sbom-component-count.txt

                            set +e
                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                aquasec/trivy:0.57.1 image \
                                --format cyclonedx \
                                --scanners vuln \
                                --timeout 10m \
                                --quiet \
                                ${IMAGE_NAME}:${IMAGE_TAG} \
                                > ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json \
                                2> ${SECURITY_REPORT_DIR}/sbom.trivy.log
                            TRIVY_SBOM_STATUS=$?
                            set -e

                            if [ "${TRIVY_SBOM_STATUS}" -ne 0 ] || [ ! -s ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json ]; then
                                echo "ERROR: Trivy CycloneDX SBOM generation failed."
                                sed -n '1,120p' ${SECURITY_REPORT_DIR}/sbom.trivy.log || true
                                exit 1
                            fi

                            GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                            CYCLONEDX_BYTES="$(wc -c < ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json | tr -d ' ')"
                            COMPONENT_COUNT="$(grep -o '"bom-ref"' ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json | wc -l | tr -d ' ')"
                            [ -n "${COMPONENT_COUNT}" ] || COMPONENT_COUNT=0
                            echo "${COMPONENT_COUNT}" > ${SECURITY_REPORT_DIR}/sbom-component-count.txt

                            cat > ${SECURITY_REPORT_DIR}/sbom-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image SBOM Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #f6f8fa; color: #24292f; margin: 0; padding: 32px; }
        .panel { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: 24px; }
        .meta { color: #57606a; margin: 8px 0 18px; }
        .badge { display: inline-block; background: #ddf4ff; color: #0969da; border-radius: 999px; padding: 4px 10px; font-size: 0.8rem; font-weight: 600; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 20px 0; }
        .metric { border: 1px solid #d0d7de; border-radius: 8px; padding: 14px; background: #f6f8fa; }
        .metric strong { display: block; font-size: 1.15rem; color: #24292f; }
        .metric span { color: #57606a; font-size: 0.82rem; }
        .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0; }
        .actions a { display: inline-block; padding: 9px 14px; border-radius: 6px; background: #1f6feb; color: #fff; text-decoration: none; font-size: 0.9rem; }
        .actions a.secondary { background: #57606a; }
        pre { background: #0d1117; color: #c9d1d9; border-radius: 8px; padding: 16px; overflow: auto; max-height: 420px; font-size: 0.8rem; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Image SBOM Report</h1>
        <p class="meta">Image: <strong>${IMAGE_NAME}:${IMAGE_TAG}</strong></p>
        <p class="badge">Generated by Trivy (CycloneDX)</p>
        <div class="grid">
            <div class="metric"><strong>CycloneDX JSON</strong><span>${CYCLONEDX_BYTES} bytes - primary SBOM format</span></div>
            <div class="metric"><strong>${COMPONENT_COUNT}</strong><span>detected component references in CycloneDX</span></div>
            <div class="metric"><strong>${GENERATED_AT}</strong><span>generated at UTC</span></div>
        </div>
        <div class="actions">
            <a href="sbom.cyclonedx.json">Open CycloneDX JSON</a>
            <a href="sbom.trivy.log" class="secondary">Open Trivy SBOM Log</a>
        </div>
        <h2>SBOM Preview</h2>
        <pre>$(sed -n '1,120p' ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json)</pre>
    </div>
</body>
</html>
EOF

                            echo "Trivy CycloneDX SBOM generation complete. Report sizes:"
                            wc -c ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json \
                                  ${SECURITY_REPORT_DIR}/sbom-report.html \
                                  ${SECURITY_REPORT_DIR}/sbom.trivy.log
                        '''
                    }
                }
            }
        }

        stage('Container Image Vulnerability Scan (Trivy)') {
            steps {
                container('docker') {
                    script {
                        // Purpose: Scan the built container image and emit machine-readable and review-friendly outputs.
                        echo "Scanning Docker image with Trivy..."
                        sh '''
                            mkdir -p ${SECURITY_REPORT_DIR}
                            rm -f ${SECURITY_REPORT_DIR}/trivy-report.json \
                                  ${SECURITY_REPORT_DIR}/trivy-report.html \
                                  ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt \
                                  ${SECURITY_REPORT_DIR}/trivy-critical-count.txt \
                                  ${SECURITY_REPORT_DIR}/trivy-high-count.txt \
                                  ${SECURITY_REPORT_DIR}/trivy-medium-count.txt

                            set +e
                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                aquasec/trivy:0.57.1 image \
                                --format json \
                                --severity LOW,MEDIUM,HIGH,CRITICAL \
                                --scanners vuln \
                                --ignore-unfixed=false \
                                --timeout 10m \
                                --quiet \
                                ${IMAGE_NAME}:${IMAGE_TAG} \
                                > ${SECURITY_REPORT_DIR}/trivy-report.json 2>/dev/null
                            TRIVY_JSON_STATUS=$?

                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                aquasec/trivy:0.57.1 image \
                                --format template \
                                --template "@/contrib/html.tpl" \
                                --severity LOW,MEDIUM,HIGH,CRITICAL \
                                --scanners vuln \
                                --ignore-unfixed=false \
                                --timeout 10m \
                                --quiet \
                                ${IMAGE_NAME}:${IMAGE_TAG} \
                                > ${SECURITY_REPORT_DIR}/trivy-report.html 2>/dev/null
                            TRIVY_HTML_STATUS=$?
                            set -e

                            if [ ! -s ${SECURITY_REPORT_DIR}/trivy-report.json ]; then
                                echo '{}' > ${SECURITY_REPORT_DIR}/trivy-report.json
                            fi
                            if [ ! -s ${SECURITY_REPORT_DIR}/trivy-report.html ]; then
                                echo '<html><body><h1>No Trivy report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/trivy-report.html
                            fi

                            if [ "${TRIVY_JSON_STATUS}" -ne 0 ] || [ "${TRIVY_HTML_STATUS}" -ne 0 ]; then
                                TRIVY_STATUS=2
                                TRIVY_STATUS_TEXT="Trivy scan error"
                                TRIVY_STATUS_CLASS="error"
                            else
                                TRIVY_STATUS=0
                                TRIVY_STATUS_TEXT="Trivy scan completed"
                                TRIVY_STATUS_CLASS="clean"
                            fi

                            CRITICAL_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"critical"' ${SECURITY_REPORT_DIR}/trivy-report.json | wc -l | tr -d ' ')
                            HIGH_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"high"' ${SECURITY_REPORT_DIR}/trivy-report.json | wc -l | tr -d ' ')
                            MEDIUM_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"medium"' ${SECURITY_REPORT_DIR}/trivy-report.json | wc -l | tr -d ' ')

                            [ -n "${CRITICAL_COUNT}" ] || CRITICAL_COUNT=0
                            [ -n "${HIGH_COUNT}" ] || HIGH_COUNT=0
                            [ -n "${MEDIUM_COUNT}" ] || MEDIUM_COUNT=0

                            echo "${TRIVY_STATUS}" > ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt
                            echo "${CRITICAL_COUNT}" > ${SECURITY_REPORT_DIR}/trivy-critical-count.txt
                            echo "${HIGH_COUNT}" > ${SECURITY_REPORT_DIR}/trivy-high-count.txt
                            echo "${MEDIUM_COUNT}" > ${SECURITY_REPORT_DIR}/trivy-medium-count.txt

                            GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                            cat > ${SECURITY_REPORT_DIR}/trivy-summary.html <<EOF
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><title>Trivy Image Scan Summary</title></head>
<body>
  <h1>Trivy Image Scan Summary</h1>
  <p>Status: ${TRIVY_STATUS_TEXT}</p>
  <p>Image: ${IMAGE_NAME}:${IMAGE_TAG}</p>
  <p>Critical: ${CRITICAL_COUNT}</p>
  <p>High: ${HIGH_COUNT}</p>
  <p>Medium: ${MEDIUM_COUNT}</p>
  <p>Generated at: ${GENERATED_AT}</p>
  <p>Detailed HTML report: <a href="trivy-report.html">trivy-report.html</a></p>
</body>
</html>
EOF

                            echo "Trivy image scan complete. Status=${TRIVY_STATUS}, critical=${CRITICAL_COUNT}, high=${HIGH_COUNT}, medium=${MEDIUM_COUNT}"
                            wc -c ${SECURITY_REPORT_DIR}/trivy-report.json \
                                  ${SECURITY_REPORT_DIR}/trivy-report.html \
                                  ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt
                        '''
                    }
                }
            }
        }

        stage('Container Security Policy Gate (Trivy)') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Apply vulnerability policy before publication, push, and deployment.
                        echo "Evaluating security gate results..."
                        sh '''
                            GITLEAKS_STATUS="$(cat ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt 2>/dev/null || echo 2)"
                            if [ "${GITLEAKS_STATUS}" -eq 1 ]; then
                                echo "Gitleaks detected potential secrets. Failing pipeline before registry push."
                                exit 1
                            fi
                            if [ "${GITLEAKS_STATUS}" -gt 1 ]; then
                                echo "Gitleaks scan errored. Failing pipeline before registry push."
                                exit 1
                            fi

                            TRIVY_STATUS="$(cat ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt 2>/dev/null || echo 2)"
                            TRIVY_CRITICAL_COUNT="$(cat ${SECURITY_REPORT_DIR}/trivy-critical-count.txt 2>/dev/null || echo 0)"
                            TRIVY_HIGH_COUNT="$(cat ${SECURITY_REPORT_DIR}/trivy-high-count.txt 2>/dev/null || echo 0)"
                            TRIVY_MEDIUM_COUNT="$(cat ${SECURITY_REPORT_DIR}/trivy-medium-count.txt 2>/dev/null || echo 0)"

                            if [ "${TRIVY_STATUS}" -ne 0 ]; then
                                if [ "${TRIVY_BLOCK_ON_SCAN_ERROR}" = "true" ]; then
                                    echo "Trivy image scan errored. Failing pipeline before registry push."
                                    exit 1
                                fi
                                echo "WARNING: Trivy image scan errored, but pipeline continues because TRIVY_BLOCK_ON_SCAN_ERROR=${TRIVY_BLOCK_ON_SCAN_ERROR}."
                                exit 0
                            fi

                            if [ "${TRIVY_CRITICAL_COUNT}" -gt 0 ]; then
                                echo "Trivy found ${TRIVY_CRITICAL_COUNT} critical vulnerabilities. Failing pipeline before registry push."
                                exit 1
                            fi

                            if [ "${TRIVY_HIGH_COUNT}" -gt 0 ]; then
                                if [ "${TRIVY_FAIL_ON_HIGH}" = "true" ]; then
                                    echo "Trivy found ${TRIVY_HIGH_COUNT} high vulnerabilities and TRIVY_FAIL_ON_HIGH=true. Failing pipeline."
                                    exit 1
                                fi
                                echo "WARNING: Trivy found ${TRIVY_HIGH_COUNT} high vulnerabilities. Continuing because TRIVY_FAIL_ON_HIGH=false."
                            fi

                            echo "INFO: Trivy medium vulnerabilities (report-only): ${TRIVY_MEDIUM_COUNT}"
                            echo "Security gates passed. No secrets detected and no critical vulnerabilities found."
                        '''
                    }
                }
            }
        }

        stage('Publish SBOM to Dependency-Track') {
            steps {
                container('maven') {
                    script {
                        // Purpose: Reuse generated CycloneDX SBOM for dependency intelligence and tracking.
                        echo "Publishing CycloneDX SBOM to Dependency-Track..."
                        if (env.DEPENDENCY_TRACK_URL?.trim()) {
                            withCredentials([string(credentialsId: "${DEPENDENCY_TRACK_API_KEY_CREDENTIALS_ID}", variable: 'DEPENDENCY_TRACK_API_KEY')]) {
                                sh '''
                                    set -e
                                    mkdir -p ${SECURITY_REPORT_DIR}
                                    rm -f ${SECURITY_REPORT_DIR}/dependency-track-report.json \
                                          ${SECURITY_REPORT_DIR}/dependency-track-report.html \
                                          ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json

                                    if [ ! -s ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json ]; then
                                        cat > ${SECURITY_REPORT_DIR}/dependency-track-report.json <<EOF
{
  "server": "${DEPENDENCY_TRACK_URL}",
  "projectName": "${DEPENDENCY_TRACK_PROJECT_NAME}",
  "projectVersion": "${IMAGE_TAG}",
  "sbomFile": "${SECURITY_REPORT_DIR}/sbom.cyclonedx.json",
  "uploadHttpStatus": "missing_sbom",
  "result": "skipped_missing_sbom"
}
EOF

                                        cat > ${SECURITY_REPORT_DIR}/dependency-track-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dependency-Track SBOM Publish Report</title>
</head>
<body>
    <h1>Dependency-Track SBOM Publish Report</h1>
    <p>SBOM file was missing, so upload was skipped.</p>
    <p>Project: ${DEPENDENCY_TRACK_PROJECT_NAME}</p>
    <p>Version: ${IMAGE_TAG}</p>
</body>
</html>
EOF
                                        exit 0
                                    fi

                                    UPLOAD_HTTP_STATUS=000
                                    CURL_STATUS=0
                                    UPLOAD_RESULT="upload_failed"
                                    UPLOAD_STATUS_TEXT="Upload failed"
                                    UPLOAD_STATUS_CLASS="error"
                                    PROCESSING_TOKEN=""
                                    set +e
                                    UPLOAD_HTTP_STATUS=$(curl --silent --show-error --location --retry 3 --retry-all-errors \
                                        -H "X-Api-Key: ${DEPENDENCY_TRACK_API_KEY}" \
                                        -F "autoCreate=true" \
                                        -F "projectName=${DEPENDENCY_TRACK_PROJECT_NAME}" \
                                        -F "projectVersion=${IMAGE_TAG}" \
                                        -F "bom=@${SECURITY_REPORT_DIR}/sbom.cyclonedx.json" \
                                        --output ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json \
                                        --write-out "%{http_code}" \
                                        "${DEPENDENCY_TRACK_URL%/}/api/v1/bom")
                                    CURL_STATUS=$?
                                    set -e

                                    if [ ! -s ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json ]; then
                                        echo '{}' > ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json
                                    fi

                                    PROCESSING_TOKEN=$(awk -F'"' '/token/ {for (i = 1; i <= NF; i++) if ($i == "token") {print $(i + 2); exit}}' ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json)

                                    if [ "${CURL_STATUS}" -ne 0 ]; then
                                        echo "WARN: Dependency-Track upload request returned curl exit ${CURL_STATUS}."
                                    elif [ "${UPLOAD_HTTP_STATUS}" -ge 200 ] && [ "${UPLOAD_HTTP_STATUS}" -lt 300 ]; then
                                        UPLOAD_RESULT="upload_succeeded"
                                        UPLOAD_STATUS_TEXT="Upload accepted by Dependency-Track"
                                        UPLOAD_STATUS_CLASS="success"
                                    fi

                                    cat > ${SECURITY_REPORT_DIR}/dependency-track-report.json <<EOF
{
  "server": "${DEPENDENCY_TRACK_URL}",
  "projectName": "${DEPENDENCY_TRACK_PROJECT_NAME}",
  "projectVersion": "${IMAGE_TAG}",
  "sbomFile": "${SECURITY_REPORT_DIR}/sbom.cyclonedx.json",
  "uploadHttpStatus": "${UPLOAD_HTTP_STATUS}",
  "curlExitCode": "${CURL_STATUS}",
    "processingToken": "${PROCESSING_TOKEN}",
  "responseFile": "${SECURITY_REPORT_DIR}/dependency-track-upload-response.json",
    "result": "${UPLOAD_RESULT}"
}
EOF

                                    cat > ${SECURITY_REPORT_DIR}/dependency-track-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dependency-Track SBOM Publish Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #f6f8fa; color: #24292f; margin: 0; padding: 32px; }
        .panel { max-width: 960px; margin: 0 auto; background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: 24px; }
        .badge { display: inline-block; border-radius: 999px; padding: 4px 10px; font-size: 0.8rem; font-weight: 600; }
        .badge.success { background: #dafbe1; color: #116329; }
        .badge.error { background: #ffebe9; color: #cf222e; }
        .meta { color: #57606a; margin: 10px 0 18px; }
        pre { background: #0d1117; color: #c9d1d9; border-radius: 8px; padding: 16px; overflow: auto; max-height: 360px; font-size: 0.82rem; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Dependency-Track SBOM Publish Report</h1>
        <p class="badge ${UPLOAD_STATUS_CLASS}">${UPLOAD_STATUS_TEXT}</p>
        <p class="meta">Project: <strong>${DEPENDENCY_TRACK_PROJECT_NAME}</strong> &nbsp;·&nbsp; Version: <strong>${IMAGE_TAG}</strong></p>
        <p class="meta">Server: <strong>${DEPENDENCY_TRACK_URL}</strong></p>
        <p class="meta">SBOM source: <strong>${SECURITY_REPORT_DIR}/sbom.cyclonedx.json</strong></p>
        <p class="meta">Upload status code: <strong>${UPLOAD_HTTP_STATUS}</strong> &nbsp;·&nbsp; curl exit: <strong>${CURL_STATUS}</strong></p>
        <p class="meta">Processing token: <strong>${PROCESSING_TOKEN}</strong></p>
        <h2>Upload Response</h2>
        <pre>$(sed -n '1,120p' ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json)</pre>
    </div>
</body>
</html>
EOF

                                    if [ "${UPLOAD_RESULT}" != "upload_succeeded" ]; then
                                        echo "ERROR: Dependency-Track BOM upload failed with HTTP ${UPLOAD_HTTP_STATUS} and curl exit ${CURL_STATUS}."
                                        sed -n '1,120p' ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json
                                        exit 1
                                    fi
                                '''
                            }
                        } else {
                            sh '''
                                mkdir -p ${SECURITY_REPORT_DIR}
                                cat > ${SECURITY_REPORT_DIR}/dependency-track-report.json <<EOF
{
  "server": "",
  "projectName": "${DEPENDENCY_TRACK_PROJECT_NAME}",
  "projectVersion": "${IMAGE_TAG}",
  "sbomFile": "${SECURITY_REPORT_DIR}/sbom.cyclonedx.json",
  "uploadHttpStatus": "skipped",
  "result": "skipped_not_configured"
}
EOF
                                cat > ${SECURITY_REPORT_DIR}/dependency-track-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dependency-Track SBOM Publish Report</title>
</head>
<body>
    <h1>Dependency-Track SBOM Publish Report</h1>
    <p>Dependency-Track URL is not configured in Jenkins, so the SBOM upload was skipped.</p>
    <p>Project: ${DEPENDENCY_TRACK_PROJECT_NAME}</p>
    <p>Version: ${IMAGE_TAG}</p>
    <p>SBOM: ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json</p>
</body>
</html>
EOF
                            '''
                        }
                    }
                }
            }
        }

        stage('Archive Security Reports') {
            steps {
                script {
                    // Purpose: Persist generated security evidence as Jenkins artifacts for audit and automation.
                    archiveArtifacts artifacts: 'supply-chain-security-ref/security-reports/**/*.json,supply-chain-security-ref/security-reports/**/*.html,supply-chain-security-ref/security-reports/**/*.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Legacy Scan Docker Image (Disabled)') {
            when {
                expression { return false }
            }
            steps {
                container('docker') {
                    script {
                        echo "Scanning Docker image for vulnerabilities..."
                        // Security gating policy is intentionally not enforced in this pipeline.
                        // This stage always generates reports and never fails the build.
                        sh '''
                                mkdir -p ${SECURITY_REPORT_DIR}
                                rm -f ${SECURITY_REPORT_DIR}/trivy-report.json ${SECURITY_REPORT_DIR}/trivy-report.html

                                echo "Running Trivy JSON scan for ${IMAGE_NAME}:${IMAGE_TAG}"
                                docker run --rm \
                                    -v /var/run/docker.sock:/var/run/docker.sock \
                                    aquasec/trivy:0.57.1 image \
                                    --format json \
                                    --severity LOW,MEDIUM,HIGH,CRITICAL \
                                    --scanners vuln \
                                    --ignore-unfixed=false \
                                    --timeout 10m \
                                    --quiet \
                                    ${IMAGE_NAME}:${IMAGE_TAG} \
                                    > ${SECURITY_REPORT_DIR}/trivy-report.json 2>/dev/null || echo '{}' > ${SECURITY_REPORT_DIR}/trivy-report.json

                                echo "Running Trivy HTML scan for ${IMAGE_NAME}:${IMAGE_TAG}"
                                docker run --rm \
                                    -v /var/run/docker.sock:/var/run/docker.sock \
                                    aquasec/trivy:0.57.1 image \
                                    --format template \
                                    --template "@/contrib/html.tpl" \
                                    --severity LOW,MEDIUM,HIGH,CRITICAL \
                                    --scanners vuln \
                                    --ignore-unfixed=false \
                                    --timeout 10m \
                                    --quiet \
                                    ${IMAGE_NAME}:${IMAGE_TAG} \
                                    > ${SECURITY_REPORT_DIR}/trivy-report.html 2>/dev/null || echo '<html><body><h1>No Trivy report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/trivy-report.html

                                echo "Trivy scan complete. Report sizes:"
                                wc -c ${SECURITY_REPORT_DIR}/trivy-report.json ${SECURITY_REPORT_DIR}/trivy-report.html
                        '''
                    }
                }
            }
        }

        stage('Legacy Trivy Gate Placeholder (Disabled)') {
            when {
                expression { return false }
            }
            steps {
                container('maven') {
                    script {
                        echo "Evaluating Trivy image gate placeholder (warn-only)..."
                        sh '''
                            mkdir -p ${SECURITY_REPORT_DIR}

                            TRIVY_REPORT_FILE="${SECURITY_REPORT_DIR}/trivy-report.json"
                            TRIVY_SUMMARY_FILE="${SECURITY_REPORT_DIR}/trivy-summary.html"

                            if [ ! -s "${TRIVY_REPORT_FILE}" ]; then
                                echo "WARNING: ${TRIVY_REPORT_FILE} is missing. Trivy gate placeholder check skipped." | tee "${TRIVY_SUMMARY_FILE}"
                                exit 0
                            fi

                            CRITICAL_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"critical"' "${TRIVY_REPORT_FILE}" | wc -l | tr -d ' ')
                            HIGH_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"high"' "${TRIVY_REPORT_FILE}" | wc -l | tr -d ' ')
                            MEDIUM_COUNT=$(grep -oi '"severity"[[:space:]]*:[[:space:]]*"medium"' "${TRIVY_REPORT_FILE}" | wc -l | tr -d ' ')

                            [ -n "${CRITICAL_COUNT}" ] || CRITICAL_COUNT=0
                            [ -n "${HIGH_COUNT}" ] || HIGH_COUNT=0
                            [ -n "${MEDIUM_COUNT}" ] || MEDIUM_COUNT=0

                            WARNINGS=0
                            if [ "${CRITICAL_COUNT}" -gt "${TRIVY_GATE_MAX_CRITICAL}" ]; then
                                echo "WARNING: Trivy critical count ${CRITICAL_COUNT} exceeds relaxed placeholder threshold ${TRIVY_GATE_MAX_CRITICAL}."
                                WARNINGS=$((WARNINGS + 1))
                            fi
                            if [ "${HIGH_COUNT}" -gt "${TRIVY_GATE_MAX_HIGH}" ]; then
                                echo "WARNING: Trivy high count ${HIGH_COUNT} exceeds relaxed placeholder threshold ${TRIVY_GATE_MAX_HIGH}."
                                WARNINGS=$((WARNINGS + 1))
                            fi
                            if [ "${MEDIUM_COUNT}" -gt "${TRIVY_GATE_MAX_MEDIUM}" ]; then
                                echo "WARNING: Trivy medium count ${MEDIUM_COUNT} exceeds relaxed placeholder threshold ${TRIVY_GATE_MAX_MEDIUM}."
                                WARNINGS=$((WARNINGS + 1))
                            fi

                            {
                                echo "Trivy Gate Placeholder Summary"
                                echo "Critical=${CRITICAL_COUNT} (max ${TRIVY_GATE_MAX_CRITICAL})"
                                echo "High=${HIGH_COUNT} (max ${TRIVY_GATE_MAX_HIGH})"
                                echo "Medium=${MEDIUM_COUNT} (max ${TRIVY_GATE_MAX_MEDIUM})"
                                echo "Warnings=${WARNINGS}"
                                echo "Result=warn-only-non-blocking"
                            } > "${TRIVY_SUMMARY_FILE}"

                            if [ "${WARNINGS}" -gt 0 ]; then
                                echo "WARNING: Trivy gate placeholder thresholds exceeded. Continuing because this gate is non-blocking by design."
                            else
                                echo "Trivy gate placeholder check is within relaxed thresholds."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }


        stage('Commit Security Reports') {
            steps {
                container('maven') {
                    script {
                        echo "Committing security reports to repository..."
                        withCredentials([sshUserPrivateKey(credentialsId: "${GITHUB_CREDENTIALS_ID}", keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                            dir("${WORKSPACE}") {
                                sh '''
                                    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
                                    if [ -z "${REPO_ROOT}" ]; then
                                        REPO_ROOT="$(find "${WORKSPACE}" -maxdepth 4 -type d -name .git 2>/dev/null | head -n 1 | sed 's|/.git$||')"
                                    fi
                                    if [ -z "${REPO_ROOT}" ]; then
                                        echo "ERROR: Could not locate git repository root under ${WORKSPACE}"
                                        echo "Workspace listing for diagnostics:"
                                        ls -la "${WORKSPACE}" || true
                                        exit 1
                                    fi
                                    echo "Using repository root: ${REPO_ROOT}"
                                    cd "${REPO_ROOT}"

                                    mkdir -p ${SECURITY_REPORT_DIR}
                                    test -f ${SECURITY_REPORT_DIR}/trivy-report.json || echo '{}' > ${SECURITY_REPORT_DIR}/trivy-report.json
                                    test -f ${SECURITY_REPORT_DIR}/trivy-report.html || echo '<html><body><h1>No Trivy report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/trivy-report.html
                                    test -f ${SECURITY_REPORT_DIR}/trivy-summary.html || echo '<html><body><h1>No Trivy summary report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/trivy-summary.html
                                    test -f ${SECURITY_REPORT_DIR}/gitleaks-report.json || echo '[]' > ${SECURITY_REPORT_DIR}/gitleaks-report.json
                                    test -f ${SECURITY_REPORT_DIR}/gitleaks-report.html || echo '<html><body><h1>No Gitleaks report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/gitleaks-report.html
                                    test -f ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt || echo '2' > ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt
                                                                        test -f ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json || echo '{"bomFormat":"CycloneDX","specVersion":"1.6","version":1,"components":[]}' > ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json
                                                                        test -f ${SECURITY_REPORT_DIR}/sbom.trivy.log || echo 'No Trivy SBOM log generated in this build.' > ${SECURITY_REPORT_DIR}/sbom.trivy.log
                                                                        test -f ${SECURITY_REPORT_DIR}/sbom-component-count.txt || echo '0' > ${SECURITY_REPORT_DIR}/sbom-component-count.txt
                                    test -f ${SECURITY_REPORT_DIR}/sbom-report.html || echo '<html><body><h1>No SBOM report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/sbom-report.html
                                    test -f ${SECURITY_REPORT_DIR}/dependency-track-report.json || echo '{"result":"skipped_not_generated"}' > ${SECURITY_REPORT_DIR}/dependency-track-report.json
                                    test -f ${SECURITY_REPORT_DIR}/dependency-track-report.html || echo '<html><body><h1>No Dependency-Track report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/dependency-track-report.html
                                    test -f ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json || echo '{}' > ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json
                                                                        test -f ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt || echo '2' > ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt
                                                                        test -f ${SECURITY_REPORT_DIR}/trivy-critical-count.txt || echo '0' > ${SECURITY_REPORT_DIR}/trivy-critical-count.txt
                                                                        test -f ${SECURITY_REPORT_DIR}/trivy-high-count.txt || echo '0' > ${SECURITY_REPORT_DIR}/trivy-high-count.txt
                                                                        test -f ${SECURITY_REPORT_DIR}/trivy-medium-count.txt || echo '0' > ${SECURITY_REPORT_DIR}/trivy-medium-count.txt
                                                                        test -f ${SECURITY_REPORT_DIR}/trivy-summary.html || echo '<html><body><h1>No Trivy summary report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/trivy-summary.html
                                      test -f ${SECURITY_REPORT_DIR}/sonarqube-report.json || echo '{"note":"No SonarQube report generated"}' > ${SECURITY_REPORT_DIR}/sonarqube-report.json
                                      test -f ${SECURITY_REPORT_DIR}/sonarqube-report.html || echo '<html><body><h1>No SonarQube report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/sonarqube-report.html
                                      test -f ${SECURITY_REPORT_DIR}/dependency-check-report.json || echo '{"note":"No Dependency-Check report generated"}' > ${SECURITY_REPORT_DIR}/dependency-check-report.json
                                      test -f ${SECURITY_REPORT_DIR}/dependency-check-report.html || echo '<html><body><h1>No Dependency-Check report generated</h1></body></html>' > ${SECURITY_REPORT_DIR}/dependency-check-report.html

                                    REPORT_STAGING_DIR="$(mktemp -d)"
                                    cp -R ${SECURITY_REPORT_DIR} "${REPORT_STAGING_DIR}/security-reports"
                                    if [ -d supply-chain-security-ref/sample-application/target/site/jacoco ]; then
                                        mkdir -p "${REPORT_STAGING_DIR}/jacoco"
                                        cp -R supply-chain-security-ref/sample-application/target/site/jacoco/. "${REPORT_STAGING_DIR}/jacoco/"
                                    fi

                                    git rev-parse --is-inside-work-tree
                                    git config user.name "Jenkins CI"
                                    git config user.email "jenkins-ci@local"

                                    # Use SSH key credentials for Git operations.
                                    export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

                                    # Jenkins may build an older detached commit while main has moved.
                                    # Rebase the report commit on the latest main before pushing.
                                    git fetch origin main
                                    git reset --hard
                                    git clean -fd
                                    git checkout -B main origin/main
                                    rm -rf ${SECURITY_REPORT_DIR}
                                    cp -R "${REPORT_STAGING_DIR}/security-reports" ${SECURITY_REPORT_DIR}
                                    if [ -d "${REPORT_STAGING_DIR}/jacoco" ]; then
                                        rm -rf supply-chain-security-ref/docs/security-reports/jacoco
                                        mkdir -p supply-chain-security-ref/docs/security-reports/jacoco
                                        cp -R "${REPORT_STAGING_DIR}/jacoco/." supply-chain-security-ref/docs/security-reports/jacoco/
                                    fi
                                    rm -rf "${REPORT_STAGING_DIR}"

                                    # Publish latest reports to the web dashboard folder.
                                    mkdir -p supply-chain-security-ref/docs/security-reports
                                    cp ${SECURITY_REPORT_DIR}/trivy-report.html supply-chain-security-ref/docs/security-reports/trivy-report.html
                                    cp ${SECURITY_REPORT_DIR}/trivy-report.json supply-chain-security-ref/docs/security-reports/trivy-report.json
                                    cp ${SECURITY_REPORT_DIR}/trivy-summary.html supply-chain-security-ref/docs/security-reports/trivy-summary.html
                                    cp ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt supply-chain-security-ref/docs/security-reports/trivy-scan-exit-code.txt
                                    cp ${SECURITY_REPORT_DIR}/trivy-critical-count.txt supply-chain-security-ref/docs/security-reports/trivy-critical-count.txt
                                    cp ${SECURITY_REPORT_DIR}/trivy-high-count.txt supply-chain-security-ref/docs/security-reports/trivy-high-count.txt
                                    cp ${SECURITY_REPORT_DIR}/trivy-medium-count.txt supply-chain-security-ref/docs/security-reports/trivy-medium-count.txt
                                    cp ${SECURITY_REPORT_DIR}/gitleaks-report.html supply-chain-security-ref/docs/security-reports/gitleaks-report.html
                                    cp ${SECURITY_REPORT_DIR}/gitleaks-report.json supply-chain-security-ref/docs/security-reports/gitleaks-report.json
                                    cp ${SECURITY_REPORT_DIR}/sbom-report.html supply-chain-security-ref/docs/security-reports/sbom-report.html
                                    cp ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json supply-chain-security-ref/docs/security-reports/sbom.cyclonedx.json
                                    cp ${SECURITY_REPORT_DIR}/sbom.trivy.log supply-chain-security-ref/docs/security-reports/sbom.trivy.log
                                    cp ${SECURITY_REPORT_DIR}/sbom-component-count.txt supply-chain-security-ref/docs/security-reports/sbom-component-count.txt
                                                                        cp ${SECURITY_REPORT_DIR}/dependency-track-report.html supply-chain-security-ref/docs/security-reports/dependency-track-report.html
                                                                        cp ${SECURITY_REPORT_DIR}/dependency-track-report.json supply-chain-security-ref/docs/security-reports/dependency-track-report.json
                                                                        cp ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json supply-chain-security-ref/docs/security-reports/dependency-track-upload-response.json
                                                                        cp ${SECURITY_REPORT_DIR}/sonarqube-report.html supply-chain-security-ref/docs/security-reports/sonarqube-report.html
                                                                        cp ${SECURITY_REPORT_DIR}/sonarqube-report.json supply-chain-security-ref/docs/security-reports/sonarqube-report.json
                                                                        cp ${SECURITY_REPORT_DIR}/dependency-check-report.html supply-chain-security-ref/docs/security-reports/dependency-check-report.html
                                                                        cp ${SECURITY_REPORT_DIR}/dependency-check-report.json supply-chain-security-ref/docs/security-reports/dependency-check-report.json
                                    printf '{"build":"%s","timestamp":"%s"}' "${BUILD_NUMBER}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > supply-chain-security-ref/docs/security-reports/build-meta.json

                                        git add ${SECURITY_REPORT_DIR}/trivy-report.json ${SECURITY_REPORT_DIR}/trivy-report.html ${SECURITY_REPORT_DIR}/trivy-summary.html \
                                            ${SECURITY_REPORT_DIR}/trivy-scan-exit-code.txt ${SECURITY_REPORT_DIR}/trivy-critical-count.txt ${SECURITY_REPORT_DIR}/trivy-high-count.txt ${SECURITY_REPORT_DIR}/trivy-medium-count.txt \
                                            ${SECURITY_REPORT_DIR}/gitleaks-report.json ${SECURITY_REPORT_DIR}/gitleaks-report.html ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt \
                                            ${SECURITY_REPORT_DIR}/sbom-report.html ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json ${SECURITY_REPORT_DIR}/sbom.trivy.log ${SECURITY_REPORT_DIR}/sbom-component-count.txt \
                                                                                        ${SECURITY_REPORT_DIR}/dependency-track-report.html ${SECURITY_REPORT_DIR}/dependency-track-report.json ${SECURITY_REPORT_DIR}/dependency-track-upload-response.json \
                                                                                        ${SECURITY_REPORT_DIR}/sonarqube-report.html ${SECURITY_REPORT_DIR}/sonarqube-report.json \
                                                                                        ${SECURITY_REPORT_DIR}/dependency-check-report.html ${SECURITY_REPORT_DIR}/dependency-check-report.json \
                                            supply-chain-security-ref/docs/security-reports/trivy-report.html supply-chain-security-ref/docs/security-reports/trivy-report.json supply-chain-security-ref/docs/security-reports/trivy-summary.html \
                                            supply-chain-security-ref/docs/security-reports/gitleaks-report.html supply-chain-security-ref/docs/security-reports/gitleaks-report.json \
                                                                                        supply-chain-security-ref/docs/security-reports/sbom-report.html supply-chain-security-ref/docs/security-reports/sbom.cyclonedx.json supply-chain-security-ref/docs/security-reports/sbom.trivy.log supply-chain-security-ref/docs/security-reports/sbom-component-count.txt supply-chain-security-ref/docs/security-reports/dependency-track-report.html supply-chain-security-ref/docs/security-reports/dependency-track-report.json supply-chain-security-ref/docs/security-reports/dependency-track-upload-response.json \
                                                                                        supply-chain-security-ref/docs/security-reports/sonarqube-report.html supply-chain-security-ref/docs/security-reports/sonarqube-report.json \
                                                                                        supply-chain-security-ref/docs/security-reports/dependency-check-report.html supply-chain-security-ref/docs/security-reports/dependency-check-report.json \
                                            supply-chain-security-ref/docs/security-reports/build-meta.json
                                    if [ -d supply-chain-security-ref/docs/security-reports/jacoco ]; then
                                        git add supply-chain-security-ref/docs/security-reports/jacoco
                                    fi

                                    if git diff --staged --quiet; then
                                        echo "No security report changes to commit"
                                    else
                                        git commit -m "chore(security): update security reports for build ${BUILD_NUMBER} [skip ci]"
                                        git push git@github.com:Github-Arun-Repo/platform-engineering-reference-architectures.git HEAD:main
                                    fi
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Push to Registry') {
            steps {
                container('docker') {
                    script {
                        // Purpose: Push image only after security gates and SBOM publication have completed.
                        echo "Pushing Docker image to registry..."
                        withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh '''
                                mkdir -p ${SECURITY_REPORT_DIR}
                                echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                                PUSH_TAG_OUTPUT=$(docker push ${IMAGE_NAME}:${IMAGE_TAG} 2>&1)
                                echo "${PUSH_TAG_OUTPUT}"
                                docker push ${IMAGE_NAME}:${LATEST_TAG}

                                DIGEST=$(printf '%s\n' "${PUSH_TAG_OUTPUT}" | grep -Eo 'sha256:[a-f0-9]{64}' | head -n 1)
                                INSPECT_REF=$(docker image inspect ${IMAGE_NAME}:${IMAGE_TAG} --format '{{index .RepoDigests 0}}' 2>/dev/null || true)

                                if [ -n "${INSPECT_REF}" ]; then
                                    DIGEST_REF="${INSPECT_REF}"
                                elif [ -n "${DIGEST}" ]; then
                                    if [[ "${IMAGE_NAME}" == ${REGISTRY}/* ]]; then
                                        DIGEST_REF="${IMAGE_NAME}@${DIGEST}"
                                    else
                                        DIGEST_REF="${REGISTRY}/${IMAGE_NAME}@${DIGEST}"
                                    fi
                                else
                                    echo "ERROR: Could not capture immutable digest reference after push."
                                    echo "Hint: verify Docker daemon returns digest output and RepoDigests are available."
                                    exit 1
                                fi

                                printf '%s' "${DIGEST_REF}" > ${SECURITY_REPORT_DIR}/cosign-image-ref.txt
                                test -s ${SECURITY_REPORT_DIR}/cosign-image-ref.txt
                                echo "Immutable image reference for Cosign: ${DIGEST_REF}"

                                docker logout
                            '''
                        }
                    }
                }
            }
        }

        stage('Sign Image with Cosign') {
            when {
                expression { return params.ENABLE_COSIGN }
            }
            steps {
                container('maven') {
                    script {
                        echo "Signing pushed image digest with Cosign..."
                        withCredentials([
                            file(credentialsId: "${COSIGN_KEY_CREDENTIALS_ID}", variable: 'COSIGN_KEY_FILE'),
                            string(credentialsId: "${COSIGN_PASSWORD_CREDENTIALS_ID}", variable: 'COSIGN_PASSWORD'),
                            usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
                        ]) {
                            sh '''
                                mkdir -p ${SECURITY_REPORT_DIR} .tools .tools/cosign-docker-config
                                rm -f ${SECURITY_REPORT_DIR}/cosign-sign.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-verify.txt \
                                      ${SECURITY_REPORT_DIR}/cosign.pub

                                if [ ! -s ${SECURITY_REPORT_DIR}/cosign-image-ref.txt ]; then
                                    echo "ERROR: ${SECURITY_REPORT_DIR}/cosign-image-ref.txt is missing. Push stage did not record an immutable digest reference."
                                    exit 1
                                fi

                                COSIGN_URL="https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64"
                                if [ ! -x .tools/cosign ]; then
                                    echo "Downloading Cosign ${COSIGN_VERSION} from ${COSIGN_URL}"
                                    curl --fail --location --retry 3 --retry-all-errors \
                                        --connect-timeout 15 --max-time 180 --progress-bar \
                                        "${COSIGN_URL}" \
                                        --output .tools/cosign
                                    chmod +x .tools/cosign
                                fi

                                ./.tools/cosign version

                                AUTH_B64=$(printf '%s' "${DOCKER_USER}:${DOCKER_PASS}" | base64 | tr -d '\n')
                                cat > .tools/cosign-docker-config/config.json <<EOF
{"auths":{"https://index.docker.io/v1/":{"auth":"${AUTH_B64}"},"${REGISTRY}":{"auth":"${AUTH_B64}"}}}
EOF

                                export DOCKER_CONFIG="$PWD/.tools/cosign-docker-config"
                                export COSIGN_PASSWORD="${COSIGN_PASSWORD}"

                                IMAGE_DIGEST_REF=$(cat ${SECURITY_REPORT_DIR}/cosign-image-ref.txt)
                                GIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

                                ./.tools/cosign public-key --key "${COSIGN_KEY_FILE}" > ${SECURITY_REPORT_DIR}/cosign.pub

                                ./.tools/cosign sign \
                                    --yes \
                                    --tlog-upload=false \
                                    --key "${COSIGN_KEY_FILE}" \
                                    -a pipeline=jenkins \
                                    -a build-number="${BUILD_NUMBER}" \
                                    -a git-sha="${GIT_SHA}" \
                                    -a pipeline-version="${PIPELINE_VERSION}" \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-sign.txt 2>&1

                                set +e
                                ./.tools/cosign verify \
                                    --insecure-ignore-tlog=true \
                                    --key ${SECURITY_REPORT_DIR}/cosign.pub \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-verify.txt 2>&1
                                COSIGN_VERIFY_STATUS=$?
                                set -e

                                if [ "${COSIGN_VERIFY_STATUS}" -ne 0 ]; then
                                    echo "ERROR: Cosign verify failed with status ${COSIGN_VERIFY_STATUS}."
                                    echo "---- cosign-sign.txt (tail) ----"
                                    tail -n 40 ${SECURITY_REPORT_DIR}/cosign-sign.txt || true
                                    echo "---- cosign-verify.txt (tail) ----"
                                    tail -n 80 ${SECURITY_REPORT_DIR}/cosign-verify.txt || true
                                    exit ${COSIGN_VERIFY_STATUS}
                                fi

                                echo "Cosign image signing complete for ${IMAGE_DIGEST_REF}."
                            '''
                        }
                    }
                }
            }
        }

        stage('Attest Image with Cosign') {
            when {
                expression { return params.ENABLE_COSIGN }
            }
            steps {
                container('maven') {
                    script {
                        echo "Creating Cosign SBOM and build attestations..."
                        withCredentials([
                            file(credentialsId: "${COSIGN_KEY_CREDENTIALS_ID}", variable: 'COSIGN_KEY_FILE'),
                            string(credentialsId: "${COSIGN_PASSWORD_CREDENTIALS_ID}", variable: 'COSIGN_PASSWORD'),
                            usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
                        ]) {
                            sh '''
                                mkdir -p ${SECURITY_REPORT_DIR} .tools .tools/cosign-docker-config
                                rm -f ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-build-attest.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-tree.txt \
                                      ${SECURITY_REPORT_DIR}/cosign-build-attestation.json \
                                      ${SECURITY_REPORT_DIR}/cosign-report.html

                                if [ ! -x .tools/cosign ]; then
                                    echo "ERROR: .tools/cosign is missing. Signing stage did not provision Cosign."
                                    exit 1
                                fi

                                if [ ! -s ${SECURITY_REPORT_DIR}/cosign-image-ref.txt ]; then
                                    echo "ERROR: ${SECURITY_REPORT_DIR}/cosign-image-ref.txt is missing."
                                    exit 1
                                fi

                                if [ ! -s ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json ]; then
                                    echo "ERROR: ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json is missing. Cannot create SBOM attestation."
                                    exit 1
                                fi

                                AUTH_B64=$(printf '%s' "${DOCKER_USER}:${DOCKER_PASS}" | base64 | tr -d '\n')
                                cat > .tools/cosign-docker-config/config.json <<EOF
{"auths":{"https://index.docker.io/v1/":{"auth":"${AUTH_B64}"},"${REGISTRY}":{"auth":"${AUTH_B64}"}}}
EOF

                                export DOCKER_CONFIG="$PWD/.tools/cosign-docker-config"
                                export COSIGN_PASSWORD="${COSIGN_PASSWORD}"

                                IMAGE_DIGEST_REF=$(cat ${SECURITY_REPORT_DIR}/cosign-image-ref.txt)
                                GIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
                                GITLEAKS_STATUS=$(cat ${SECURITY_REPORT_DIR}/gitleaks-exit-code.txt 2>/dev/null || echo 2)
                                TRIVY_CRITICAL_COUNT=$(cat ${SECURITY_REPORT_DIR}/trivy-critical-count.txt 2>/dev/null || echo 0)
                                TRIVY_HIGH_COUNT=$(cat ${SECURITY_REPORT_DIR}/trivy-high-count.txt 2>/dev/null || echo 0)
                                TRIVY_MEDIUM_COUNT=$(cat ${SECURITY_REPORT_DIR}/trivy-medium-count.txt 2>/dev/null || echo 0)
                                SBOM_SHA=$(sha256sum ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json | awk '{print $1}')
                                BUILD_ATTESTATION_TYPE="https://platform-engineering-reference-architectures.dev/attestations/build-metadata/v1"

                                cat > ${SECURITY_REPORT_DIR}/cosign-build-attestation.json <<EOF
{
  "buildNumber": "${BUILD_NUMBER}",
  "pipelineVersion": "${PIPELINE_VERSION}",
  "gitSha": "${GIT_SHA}",
  "image": "${IMAGE_DIGEST_REF}",
  "sbom": {
    "path": "${SECURITY_REPORT_DIR}/sbom.cyclonedx.json",
    "sha256": "${SBOM_SHA}"
  },
  "securityGates": {
    "gitleaksStatus": "${GITLEAKS_STATUS}",
        "trivyCriticalCount": "${TRIVY_CRITICAL_COUNT}",
        "trivyHighCount": "${TRIVY_HIGH_COUNT}",
        "trivyMediumCount": "${TRIVY_MEDIUM_COUNT}"
  },
  "generatedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

                                ./.tools/cosign attest \
                                    --yes \
                                    --tlog-upload=false \
                                    --key "${COSIGN_KEY_FILE}" \
                                    --type cyclonedx \
                                    --predicate ${SECURITY_REPORT_DIR}/sbom.cyclonedx.json \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt 2>&1

                                ./.tools/cosign attest \
                                    --yes \
                                    --tlog-upload=false \
                                    --key "${COSIGN_KEY_FILE}" \
                                    --type "${BUILD_ATTESTATION_TYPE}" \
                                    --predicate ${SECURITY_REPORT_DIR}/cosign-build-attestation.json \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-build-attest.txt 2>&1

                                ./.tools/cosign verify-attestation \
                                    --insecure-ignore-tlog=true \
                                    --key ${SECURITY_REPORT_DIR}/cosign.pub \
                                    --type cyclonedx \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt 2>&1

                                ./.tools/cosign verify-attestation \
                                    --insecure-ignore-tlog=true \
                                    --key ${SECURITY_REPORT_DIR}/cosign.pub \
                                    --type "${BUILD_ATTESTATION_TYPE}" \
                                    "${IMAGE_DIGEST_REF}" \
                                    > ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt 2>&1

                                ./.tools/cosign tree "${IMAGE_DIGEST_REF}" > ${SECURITY_REPORT_DIR}/cosign-tree.txt 2>&1 || true

                                GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                                cat > ${SECURITY_REPORT_DIR}/cosign-report.html <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cosign Signature and Attestation Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #f6f8fa; color: #24292f; margin: 0; padding: 32px; }
        .panel { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: 24px; }
        .meta { color: #57606a; margin: 8px 0 18px; }
        .badge { display: inline-block; background: #dafbe1; color: #116329; border-radius: 999px; padding: 4px 10px; font-size: 0.8rem; font-weight: 600; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 20px 0; }
        .metric { border: 1px solid #d0d7de; border-radius: 8px; padding: 14px; background: #f6f8fa; }
        .metric strong { display: block; font-size: 1.1rem; color: #24292f; }
        .metric span { color: #57606a; font-size: 0.82rem; }
        .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0; }
        .actions a { display: inline-block; padding: 9px 14px; border-radius: 6px; background: #1f6feb; color: #fff; text-decoration: none; font-size: 0.9rem; }
        .actions a.secondary { background: #57606a; }
        pre { background: #0d1117; color: #c9d1d9; border-radius: 8px; padding: 16px; overflow: auto; max-height: 420px; font-size: 0.8rem; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Cosign Signature and Attestation Report</h1>
        <p class="meta">Image: <strong>${IMAGE_DIGEST_REF}</strong></p>
        <p class="badge">Signed and attested with Cosign</p>
        <div class="grid">
            <div class="metric"><strong>1</strong><span>image signature created for immutable digest</span></div>
            <div class="metric"><strong>2</strong><span>attestations published: CycloneDX SBOM and build metadata</span></div>
            <div class="metric"><strong>${SBOM_SHA}</strong><span>sha256 of CycloneDX predicate used for attestation</span></div>
            <div class="metric"><strong>${GENERATED_AT}</strong><span>generated at UTC</span></div>
        </div>
        <div class="actions">
            <a href="cosign-build-attestation.json">Open Build Attestation Predicate</a>
            <a href="sbom.cyclonedx.json" class="secondary">Open SBOM Predicate</a>
            <a href="cosign.pub" class="secondary">Open Public Key</a>
        </div>
        <h2>Verification Preview</h2>
        <pre>$(sed -n '1,120p' ${SECURITY_REPORT_DIR}/cosign-verify.txt)</pre>
        <h2>Attached Referrers Preview</h2>
        <pre>$(sed -n '1,120p' ${SECURITY_REPORT_DIR}/cosign-tree.txt)</pre>
    </div>
</body>
</html>
EOF

                                echo "Cosign attestation complete for ${IMAGE_DIGEST_REF}."
                            '''
                        }
                    }
                }
            }
        }

        stage('Validate Cosign Artifacts in Registry') {
            when {
                expression { return params.ENABLE_COSIGN }
            }
            steps {
                container('maven') {
                    script {
                        echo "Validating Cosign signature and attestations are present in Docker Hub..."
                        withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh '''
                                mkdir -p ${SECURITY_REPORT_DIR} .tools

                                if [ ! -x .tools/cosign ]; then
                                    COSIGN_URL="https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64"
                                    echo "Downloading Cosign ${COSIGN_VERSION} from ${COSIGN_URL}"
                                    curl --fail --location --retry 3 --retry-all-errors \
                                        --connect-timeout 15 --max-time 180 --progress-bar \
                                        "${COSIGN_URL}" \
                                        --output .tools/cosign
                                    chmod +x .tools/cosign
                                fi

                                if [ ! -s ${SECURITY_REPORT_DIR}/cosign-image-ref.txt ]; then
                                    echo "ERROR: ${SECURITY_REPORT_DIR}/cosign-image-ref.txt is missing. Cannot validate registry artifacts."
                                    exit 1
                                fi

                                IMAGE_DIGEST_REF=$(cat ${SECURITY_REPORT_DIR}/cosign-image-ref.txt)
                                SIG_REF=$(.tools/cosign triangulate "${IMAGE_DIGEST_REF}")
                                ATT_REF=$(.tools/cosign triangulate --type attestation "${IMAGE_DIGEST_REF}")
                                SIG_TAG="${SIG_REF##*:}"
                                ATT_TAG="${ATT_REF##*:}"

                                .tools/cosign tree "${IMAGE_DIGEST_REF}" > ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt 2>&1 || true

                                if ! grep -q '\\.sig' ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt; then
                                    echo "ERROR: Cosign signature referrer not found for ${IMAGE_DIGEST_REF}."
                                    tail -n 80 ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt || true
                                    exit 1
                                fi

                                if ! grep -q '\\.att' ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt; then
                                    echo "ERROR: Cosign attestation referrer not found for ${IMAGE_DIGEST_REF}."
                                    tail -n 80 ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt || true
                                    exit 1
                                fi

                                REPO_PATH="${IMAGE_NAME#${REGISTRY}/}"
                                REPO_PATH="${REPO_PATH#index.docker.io/}"
                                TAGS_API="https://hub.docker.com/v2/repositories/${REPO_PATH}/tags?page_size=200"

                                AUTH_B64=$(printf '%s' "${DOCKER_USER}:${DOCKER_PASS}" | base64 | tr -d '\n')
                                curl --fail --location --retry 3 --retry-all-errors \
                                    -H "Authorization: Basic ${AUTH_B64}" \
                                    "${TAGS_API}" \
                                    --output ${SECURITY_REPORT_DIR}/cosign-tags.json

                                SIG_FOUND=0
                                ATT_FOUND=0
                                if grep -Eq '"name"[[:space:]]*:[[:space:]]*"'"${SIG_TAG}"'"' ${SECURITY_REPORT_DIR}/cosign-tags.json; then
                                    SIG_FOUND=1
                                fi
                                if grep -Eq '"name"[[:space:]]*:[[:space:]]*"'"${ATT_TAG}"'"' ${SECURITY_REPORT_DIR}/cosign-tags.json; then
                                    ATT_FOUND=1
                                fi

                                if [ "${SIG_FOUND}" -ne 1 ] || [ "${ATT_FOUND}" -ne 1 ]; then
                                    echo "WARN: Docker Hub tags API did not return all expected cosign tags on this page."
                                    echo "WARN: expected_sig=${SIG_TAG} found=${SIG_FOUND}, expected_att=${ATT_TAG} found=${ATT_FOUND}"
                                    echo "WARN: Cosign tree already verified .sig/.att referrers; continuing."
                                fi

                                cat > ${SECURITY_REPORT_DIR}/cosign-registry-check.txt <<EOF
image_digest_ref=${IMAGE_DIGEST_REF}
expected_signature_ref=${SIG_REF}
expected_attestation_ref=${ATT_REF}
dockerhub_repo=${REPO_PATH}
dockerhub_signature_tag_found=${SIG_FOUND}
dockerhub_attestation_tag_found=${ATT_FOUND}
result=ok_cosign_tree_verified
EOF

                                echo "Cosign registry validation passed for ${IMAGE_DIGEST_REF}."
                            '''
                        }
                    }
                }
            }
        }

        stage('Commit Cosign Evidence') {
            when {
                expression { return params.ENABLE_COSIGN }
            }
            steps {
                container('maven') {
                    script {
                        echo "Publishing Cosign signing evidence to the repository website..."
                        withCredentials([sshUserPrivateKey(credentialsId: "${GITHUB_CREDENTIALS_ID}", keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                            dir("${WORKSPACE}") {
                                sh '''
                                    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
                                    if [ -z "${REPO_ROOT}" ]; then
                                        echo "ERROR: Could not locate git repository root for Cosign evidence commit."
                                        exit 1
                                    fi
                                    cd "${REPO_ROOT}"

                                    for required in \
                                        ${SECURITY_REPORT_DIR}/cosign-report.html \
                                        ${SECURITY_REPORT_DIR}/cosign-image-ref.txt \
                                        ${SECURITY_REPORT_DIR}/cosign.pub \
                                        ${SECURITY_REPORT_DIR}/cosign-build-attestation.json \
                                        ${SECURITY_REPORT_DIR}/cosign-sign.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-verify.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-build-attest.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-tree.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt \
                                        ${SECURITY_REPORT_DIR}/cosign-tags.json \
                                        ${SECURITY_REPORT_DIR}/cosign-registry-check.txt; do
                                        if [ ! -s "${required}" ]; then
                                            echo "ERROR: Required Cosign evidence file missing: ${required}"
                                            exit 1
                                        fi
                                    done

                                    COSIGN_STAGING_DIR="$(mktemp -d)"
                                    cp ${SECURITY_REPORT_DIR}/cosign-report.html "${COSIGN_STAGING_DIR}/cosign-report.html"
                                    cp ${SECURITY_REPORT_DIR}/cosign-image-ref.txt "${COSIGN_STAGING_DIR}/cosign-image-ref.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign.pub "${COSIGN_STAGING_DIR}/cosign.pub"
                                    cp ${SECURITY_REPORT_DIR}/cosign-build-attestation.json "${COSIGN_STAGING_DIR}/cosign-build-attestation.json"
                                    cp ${SECURITY_REPORT_DIR}/cosign-sign.txt "${COSIGN_STAGING_DIR}/cosign-sign.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-verify.txt "${COSIGN_STAGING_DIR}/cosign-verify.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt "${COSIGN_STAGING_DIR}/cosign-sbom-attest.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-build-attest.txt "${COSIGN_STAGING_DIR}/cosign-build-attest.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt "${COSIGN_STAGING_DIR}/cosign-verify-attestation-sbom.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt "${COSIGN_STAGING_DIR}/cosign-verify-attestation-build.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-tree.txt "${COSIGN_STAGING_DIR}/cosign-tree.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt "${COSIGN_STAGING_DIR}/cosign-tree-verify.txt"
                                    cp ${SECURITY_REPORT_DIR}/cosign-tags.json "${COSIGN_STAGING_DIR}/cosign-tags.json"
                                    cp ${SECURITY_REPORT_DIR}/cosign-registry-check.txt "${COSIGN_STAGING_DIR}/cosign-registry-check.txt"

                                    git config user.name "Jenkins CI"
                                    git config user.email "jenkins-ci@local"
                                    export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

                                    git fetch origin main
                                    git reset --hard
                                    git clean -fd
                                    git checkout -B main origin/main

                                    mkdir -p ${SECURITY_REPORT_DIR}
                                    mkdir -p supply-chain-security-ref/docs/security-reports

                                    cp "${COSIGN_STAGING_DIR}/cosign-report.html" ${SECURITY_REPORT_DIR}/cosign-report.html
                                    cp "${COSIGN_STAGING_DIR}/cosign-image-ref.txt" ${SECURITY_REPORT_DIR}/cosign-image-ref.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign.pub" ${SECURITY_REPORT_DIR}/cosign.pub
                                    cp "${COSIGN_STAGING_DIR}/cosign-build-attestation.json" ${SECURITY_REPORT_DIR}/cosign-build-attestation.json
                                    cp "${COSIGN_STAGING_DIR}/cosign-sign.txt" ${SECURITY_REPORT_DIR}/cosign-sign.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify.txt" ${SECURITY_REPORT_DIR}/cosign-verify.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-sbom-attest.txt" ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-build-attest.txt" ${SECURITY_REPORT_DIR}/cosign-build-attest.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify-attestation-sbom.txt" ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify-attestation-build.txt" ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tree.txt" ${SECURITY_REPORT_DIR}/cosign-tree.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tree-verify.txt" ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tags.json" ${SECURITY_REPORT_DIR}/cosign-tags.json
                                    cp "${COSIGN_STAGING_DIR}/cosign-registry-check.txt" ${SECURITY_REPORT_DIR}/cosign-registry-check.txt

                                    cp "${COSIGN_STAGING_DIR}/cosign-report.html" supply-chain-security-ref/docs/security-reports/cosign-report.html
                                    cp "${COSIGN_STAGING_DIR}/cosign-image-ref.txt" supply-chain-security-ref/docs/security-reports/cosign-image-ref.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign.pub" supply-chain-security-ref/docs/security-reports/cosign.pub
                                    cp "${COSIGN_STAGING_DIR}/cosign-build-attestation.json" supply-chain-security-ref/docs/security-reports/cosign-build-attestation.json
                                    cp "${COSIGN_STAGING_DIR}/cosign-sign.txt" supply-chain-security-ref/docs/security-reports/cosign-sign.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify.txt" supply-chain-security-ref/docs/security-reports/cosign-verify.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-sbom-attest.txt" supply-chain-security-ref/docs/security-reports/cosign-sbom-attest.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-build-attest.txt" supply-chain-security-ref/docs/security-reports/cosign-build-attest.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify-attestation-sbom.txt" supply-chain-security-ref/docs/security-reports/cosign-verify-attestation-sbom.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-verify-attestation-build.txt" supply-chain-security-ref/docs/security-reports/cosign-verify-attestation-build.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tree.txt" supply-chain-security-ref/docs/security-reports/cosign-tree.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tree-verify.txt" supply-chain-security-ref/docs/security-reports/cosign-tree-verify.txt
                                    cp "${COSIGN_STAGING_DIR}/cosign-tags.json" supply-chain-security-ref/docs/security-reports/cosign-tags.json
                                    cp "${COSIGN_STAGING_DIR}/cosign-registry-check.txt" supply-chain-security-ref/docs/security-reports/cosign-registry-check.txt
                                    rm -rf "${COSIGN_STAGING_DIR}"

                                        git add ${SECURITY_REPORT_DIR}/cosign-report.html \
                                            ${SECURITY_REPORT_DIR}/cosign-image-ref.txt \
                                            ${SECURITY_REPORT_DIR}/cosign.pub \
                                            ${SECURITY_REPORT_DIR}/cosign-build-attestation.json \
                                            ${SECURITY_REPORT_DIR}/cosign-sign.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-verify.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-sbom-attest.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-build-attest.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-verify-attestation-sbom.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-verify-attestation-build.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-tree.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-tree-verify.txt \
                                            ${SECURITY_REPORT_DIR}/cosign-tags.json \
                                            ${SECURITY_REPORT_DIR}/cosign-registry-check.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-report.html \
                                            supply-chain-security-ref/docs/security-reports/cosign-image-ref.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign.pub \
                                            supply-chain-security-ref/docs/security-reports/cosign-build-attestation.json \
                                            supply-chain-security-ref/docs/security-reports/cosign-sign.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-verify.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-sbom-attest.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-build-attest.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-verify-attestation-sbom.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-verify-attestation-build.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-tree.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-tree-verify.txt \
                                            supply-chain-security-ref/docs/security-reports/cosign-tags.json \
                                            supply-chain-security-ref/docs/security-reports/cosign-registry-check.txt

                                    if git diff --staged --quiet; then
                                        echo "No Cosign evidence changes to commit"
                                    else
                                        git commit -m "chore(security): update cosign evidence for build ${BUILD_NUMBER} [skip ci]"
                                        git push git@github.com:Github-Arun-Repo/platform-engineering-reference-architectures.git HEAD:main
                                    fi
                                '''
                            }
                        }
                    }
                }
            }
        }

    }

    post {
        always {
            script {
                echo "Pipeline execution completed"
                // Archive build artifacts if needed
                junit testResults: 'supply-chain-security-ref/sample-application/target/surefire-reports/*.xml', allowEmptyResults: true

                archiveArtifacts artifacts: 'supply-chain-security-ref/sample-application/target/**/*.jar,supply-chain-security-ref/sample-application/target/site/jacoco/**/*,supply-chain-security-ref/security-reports/trivy-report.json,supply-chain-security-ref/security-reports/trivy-report.html,supply-chain-security-ref/security-reports/trivy-summary.html,supply-chain-security-ref/security-reports/trivy-scan-exit-code.txt,supply-chain-security-ref/security-reports/trivy-critical-count.txt,supply-chain-security-ref/security-reports/trivy-high-count.txt,supply-chain-security-ref/security-reports/trivy-medium-count.txt,supply-chain-security-ref/security-reports/gitleaks-report.json,supply-chain-security-ref/security-reports/gitleaks-report.html,supply-chain-security-ref/security-reports/gitleaks-exit-code.txt,supply-chain-security-ref/security-reports/sbom-report.html,supply-chain-security-ref/security-reports/sbom.cyclonedx.json,supply-chain-security-ref/security-reports/sbom.trivy.log,supply-chain-security-ref/security-reports/sbom-component-count.txt,supply-chain-security-ref/security-reports/dependency-track-report.html,supply-chain-security-ref/security-reports/dependency-track-report.json,supply-chain-security-ref/security-reports/dependency-track-upload-response.json,supply-chain-security-ref/security-reports/sonarqube-report.html,supply-chain-security-ref/security-reports/sonarqube-report.json,supply-chain-security-ref/security-reports/cosign-report.html,supply-chain-security-ref/security-reports/cosign-image-ref.txt,supply-chain-security-ref/security-reports/cosign.pub,supply-chain-security-ref/security-reports/cosign-build-attestation.json,supply-chain-security-ref/security-reports/cosign-sign.txt,supply-chain-security-ref/security-reports/cosign-verify.txt,supply-chain-security-ref/security-reports/cosign-sbom-attest.txt,supply-chain-security-ref/security-reports/cosign-build-attest.txt,supply-chain-security-ref/security-reports/cosign-verify-attestation-sbom.txt,supply-chain-security-ref/security-reports/cosign-verify-attestation-build.txt,supply-chain-security-ref/security-reports/cosign-tree.txt,supply-chain-security-ref/security-reports/cosign-tree-verify.txt,supply-chain-security-ref/security-reports/cosign-tags.json,supply-chain-security-ref/security-reports/cosign-registry-check.txt', allowEmptyArchive: true

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'trivy-report.html',
                    reportName: 'Trivy CVE Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'trivy-summary.html',
                    reportName: 'Trivy Security Gate Summary',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/sample-application/target/site/jacoco',
                    reportFiles: 'index.html',
                    reportName: 'JaCoCo Code Coverage Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'gitleaks-report.html',
                    reportName: 'Gitleaks Secret Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'sbom-report.html',
                    reportName: 'Image SBOM Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'dependency-track-report.html',
                    reportName: 'Dependency-Track SBOM Publish Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'sonarqube-report.html',
                    reportName: 'SonarQube Summary Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                publishHTML(target: [
                    reportDir: 'supply-chain-security-ref/security-reports',
                    reportFiles: 'cosign-report.html',
                    reportName: 'Cosign Signature and Attestation Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                sh '''
                    echo "Current user:"
                    id || true

                    echo "Fixing workspace permissions..."
                    chmod -R u+rwX "${WORKSPACE}" 2>/dev/null || true
                '''

